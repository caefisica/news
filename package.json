{
  "name": "news",
  "version": "0.0.1",
  "private": true,
  "author": "David Duran <contacto@altmails.com> (https://totallynotdavid.github.io/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/caefisica/news.git"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "cf-wrangler dev",
    "ingest": "bun scripts/ingest.ts",
    "types": "cf workers types && (cd workers/consumer && cf workers types) && (cd workers/coordinator && cf workers types) && nuxt prepare",
    "lint": "bun run types && oxlint --deny-warnings && oxfmt --check .",
    "fix": "bun run types && oxlint --fix && oxfmt .",
    "typecheck": "bun run types && nuxt typecheck && tsc -p test && tsc -p packages/feeds && tsc -p workers/consumer && tsc -p workers/coordinator",
    "test": "bun run types && vitest run",
    "build": "nuxt build && cf-wrangler build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:local": "bun scripts/migrate.ts --local --persist-to .wrangler/state",
    "deploy:news": "bun run build && cf deploy --prebuilt",
    "deploy:coordinator": "cd workers/coordinator && cf deploy",
    "deploy:consumer": "cd workers/consumer && cf deploy"
  },
  "dependencies": {
    "@news-reader/feeds": "workspace:*",
    "@nuxt/icon": "2.6.2",
    "nuxt": "4.6.4",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "1.2.0",
    "@nuxtjs/color-mode": "4.1.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.30",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
