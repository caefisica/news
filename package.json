{
  "name": "news-reader",
  "version": "0.0.1",
  "private": true,
  "author": "David Duran <contacto@altmails.com> (https://totallynotdavid.github.io/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/caefisica/rss-reader.git"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "cf-wrangler dev",
    "build": "nuxt build && cf-wrangler build",
    "deploy": "bun run build && cf deploy --prebuilt",
    "types": "cf workers types && bun run --filter './workers/*' types",
    "typecheck": "bun run types && nuxt typecheck && tsc -p packages/feeds && tsc -p workers/consumer && tsc -p workers/coordinator",
    "ingest": "bun run scripts/ingest.ts",
    "db:migrate": "cf d1 migrations apply 80dc5943-d28a-4c4b-91dd-6bbf712bfae6 --dir server/db/migrations",
    "db:migrate:local": "cf d1 migrations apply 80dc5943-d28a-4c4b-91dd-6bbf712bfae6 --dir server/db/migrations --local --persist-to .wrangler/state",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@news-reader/feeds": "workspace:*",
    "@nuxt/icon": "^2.5.1",
    "gsap": "^3.15.0",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "cf": "^1.0.0-beta.12",
    "miniflare": "5.20261001.0-alpha",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
