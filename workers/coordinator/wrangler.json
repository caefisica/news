{
  "name": "news-reader-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-reader",
      "database_id": "80dc5943-d28a-4c4b-91dd-6bbf712bfae6"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEED_QUEUE",
        "queue": "feed-ingestion"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
